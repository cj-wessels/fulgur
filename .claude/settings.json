{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_response.worktreePath // empty' | { read -r wt; [ -n \"$wt\" ] \u0026\u0026 git -C \"$wt\" sparse-checkout disable 2\u003e/dev/null; cd \"$wt\" \u0026\u0026 mise trust 2\u003e/dev/null; } || true",
            "type": "command"
          }
        ],
        "matcher": "EnterWorktree"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}